+/** Keep CSS virtual IDs and lightningcss module hashes independent of checkout roots. */
+function stableAssetPath(fileId: string): string {
+  const repositoryPath = relative(REPOSITORY_ROOT, fileId).split(sep).join('/')
+  return repositoryPath.startsWith('../') || isAbsolute(repositoryPath) ? fileId : repositoryPath
+}
+
+/** Recover the physical file from a checkout-relative virtual asset ID. */
+function physicalAssetPath(stablePath: string): string {
+  return isAbsolute(stablePath) ? stablePath : resolvePath(REPOSITORY_ROOT, stablePath)
+}
