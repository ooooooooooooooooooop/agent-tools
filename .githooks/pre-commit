#!/usr/bin/env bash
# Pre-commit gate for the agent-tooling repository.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Runs the deterministic local gates: repo structure, skill quality, Python
# syntax, unit tests, and whitespace checks. Markdown linting and MCP tests run
# in CI (they need external tools); the hook stays dependency-free and fast.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Git exports GIT_INDEX_FILE (relative ".git/index") into hook env; any child
# git process running inside ANOTHER repo/worktree (e.g. the workspace
# isolation tests) resolves it against that repo and fails with
# ".git/index.lock: No such file or directory". Clear repo-scoping vars so
# test/git subprocesses are hermetic.
unset GIT_INDEX_FILE GIT_PREFIX GIT_DIR GIT_WORK_TREE \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_NAMESPACE 2>/dev/null || true

PY="${PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || PY=python

step() { printf '\n== %s ==\n' "$1"; }

step "canonical writer ownership"
"$PY" scripts/governance/canonical_writer.py pre-commit

step "validate_repo.py --strict"
"$PY" scripts/validate_repo.py --strict

step "skill-quality-gate --strict"
"$PY" skills/skill-quality-gate/scripts/quality_report.py --root . --strict

step "python syntax (py_compile)"
FAILED=0
while IFS= read -r -d '' f; do
  "$PY" -m py_compile "$f" || FAILED=1
done < <(find . -name "*.py" -not -path "*/__pycache__/*" -print0)
if [ "$FAILED" -ne 0 ]; then
  echo "python syntax check: FAIL"
  exit 1
fi

step "repository regression tests"
"$PY" -m unittest discover -s tests -q

step "whitespace check (git diff --check)"
git diff --cached --check
git diff --check

echo
echo "pre-commit gate: PASS"
